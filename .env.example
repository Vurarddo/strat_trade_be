# Copy to `.env`. Do not commit real credentials.

# --- SSID (required: one of the two options) ---
# Option A — inline (less common for local dev):
# POCKET_OPTION_SSID=
# STRAT_TRADE_POCKET_OPTION_SSID=

# Option B — single-line file (recommended; path is relative to process cwd, usually repo root):
POCKET_OPTION_SSID_FILE=.ssid
# Same idea, alternate env names: POCKETOPTION_SSID_FILE, pocketoption_ssid_file

# The `.ssid` file must be one line, no quotes around the whole value. Accepted shapes:
# - Full WebSocket auth frame, e.g. 42["auth",{"session":"...","isDemo":1,"uid":...,"platform":1,...}]
# - Or raw session string only (see pocketoptionapi-async docs)

# --- Account / SDK ---
# Demo vs live: used when SSID is a raw token. If SSID is a full 42["auth",...] line, the
# adapter syncs is_demo from the frame's "isDemo" field before connecting (live frame + demo
# endpoints was a common failure mode).
# false = live ("isDemo":0 in auth frame), true = demo ("isDemo":1).
# With a full 42["auth",...] line, the adapter still syncs is_demo from JSON before connect().
POCKET_OPTION_IS_DEMO=true

# Optional broker region hint if your account requires it
# POCKET_OPTION_REGION=

# Send the captured 42["auth",...] line exactly as in the browser (recommended; default true).
# Set false if you only use a raw session token and rely on the SDK to build the frame.
# POCKET_OPTION_USE_RAW_AUTH_FRAME=true

# Verbose pocketoptionapi-async logs on stderr (troubleshoot connect/auth failures)
# POCKET_OPTION_SDK_DEBUG=false
